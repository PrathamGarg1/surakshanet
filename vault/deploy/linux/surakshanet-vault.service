[Unit]
Description=SurakshaNet Privileged Tamper-Evident Evidence Vault Daemon
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/surakshanet-vault daemon --vault-dir /var/lib/surakshanet/vault --network unix --addr /run/surakshanet/vault.sock --heartbeat-timeout 5m
Restart=always
RestartSec=3
RuntimeDirectory=surakshanet
RuntimeDirectoryMode=0755
StateDirectory=surakshanet
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/surakshanet /run/surakshanet /dev/tpmrm0

[Install]
WantedBy=multi-user.target
