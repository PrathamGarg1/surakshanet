{
  "manifest_version": 3,
  "name": "SurakshaNet",
  "version": "2.0.0",
  "description": "On-device Hindi + English abuse detection.",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://twitter.com/*",
    "https://x.com/*",
    "https://www.instagram.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "SurakshaNet"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.instagram.com/*"
      ],
      "js": ["src/content/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "assets/models/*", "assets/models/custom-macd-model/*", "assets/models/custom-macd-model/onnx/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
